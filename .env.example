# 공개용 키만 이 파일에 해당합니다. 값은 .env.local(로컬) 또는 GitHub Actions Secrets(배포)에 넣으세요.
# Supabase 프로젝트 설정 > API 에서 복사 (anon public 키만 사용, service_role은 절대 넣지 않음)
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
# npx web-push generate-vapid-keys 로 만든 공개 키. 비밀 키는 Supabase Edge Function Secrets에만 둡니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_ME
# 결제(프리미엄) 화면을 켤지 여부. scripts/setup-payments.mjs 가 배포용으로 true를 등록합니다.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# 결제사: toss(기본) 또는 stripe. 토스 클라이언트 키(test_ck_ 또는 live_ck_)는 공개용 키입니다. 시크릿 키는 Edge Function Secrets에만.
NEXT_PUBLIC_PAYMENT_PROVIDER=toss
NEXT_PUBLIC_TOSS_CLIENT_KEY=REPLACE_ME
NEXT_PUBLIC_PREMIUM_PRICE_KRW=4900
